rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /colecoes/{usuario} {
      allow read, write: if request.auth != null && request.auth.uid == usuario;
      match /revisoes/{revisao} {
        allow read, write: if request.auth != null && request.auth.uid == usuario;
        match /partes/{parte} {
          allow read, write: if request.auth != null && request.auth.uid == usuario;
        }
      }
    }
  }
}
